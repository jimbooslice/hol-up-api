discovery.docker "api" {
  host = "unix:///var/run/docker.sock"
  refresh_interval = "5s"
  filter {
    name = "label"
    values = ["holup.logs=true", "com.docker.compose.project=" + sys.env("COMPOSE_PROJECT_NAME")]
  }
}

loki.source.docker "api" {
  host = "unix:///var/run/docker.sock"
  targets = discovery.docker.api.targets
  refresh_interval = "5s"
  labels = { service_name = "hol-up-api", environment = "local" }
  forward_to = [loki.relabel.api.receiver]
}

loki.relabel "api" {
  rule {
    action = "labelkeep"
    regex = "service_name|environment"
  }
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://lgtm:3100/loki/api/v1/push"
  }
}
